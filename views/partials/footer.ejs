  <script>
    // Popup fuction
    function showPopup(message) {
      const popup = document.createElement("div");
      popup.className = "popup";
      popup.innerText = message;
  
      document.body.appendChild(popup);
  
      setTimeout(() => {
        popup.classList.add("fade-out");
        setTimeout(() => popup.remove(), 500);
      }, 3000);
    }
  </script>
  <script>
  function recaptchaCallback() {
    console.log("✅ reCAPTCHA bestätigt");
  }
</script>
  <script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector(".contact_form");
    console.log("📦 Kontaktformular gefunden:", form);

    if (!form) {
      console.error("❌ Formular nicht gefunden");
      return;
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      const token = grecaptcha.getResponse();
      console.log("📨 Sende Formular mit Token:", token);

      if (!token) {
        showPopup("Bitte reCAPTCHA bestätigen.");
        return;
      }

      const formData = new FormData(form);
      formData.append("g-recaptcha-response", token);

      try {
        const response = await fetch("/send-email", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();
        console.log("✅ Serverantwort:", result);
        showPopup(result.message || "Nachricht gesendet.");

        if (result.success) {
          form.reset();
          grecaptcha.reset();
        }

      } catch (err) {
        console.error("❌ Fehler beim Senden:", err);
        showPopup("Fehler beim Senden der Nachricht.");
      }
    });
  });
</script>
  </body>
  </html>