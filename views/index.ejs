<div id="contact_section" class="section">
  <div class="container ryplaContainer">

    <h2>kontakt</h2>
    <div class="contact_container">
      <form class="contact_form" action="/send-email" method="POST">
        <label for="name">name, vorname</label>
        <input type="text" id="name" name="name" placeholder="name" required />

        <label for="email">e-mail adresse</label>
        <input type="email" id="email" name="email" placeholder="e-mail" required />

        <label for="phone">telefonnummer</label>
        <input type="tel" id="phone" name="phone" placeholder="telefonnummer" />

        <label for="message">nachricht</label>
        <textarea id="message" name="message" placeholder="ihre nachricht" rows="4" required></textarea>

        <button 
          class="g-recaptcha" 
          data-sitekey="<%= locals.recaptchaSiteKey %>" 
          data-callback='onSubmit' 
          data-action='submit'
          type="button">
          senden
        </button>
      </form>
      <div class="contact_image">
        <img src="https://picsum.photos/400/400" alt="Kontakt Bild" />
      </div>
    </div>
  </div>
</div>
